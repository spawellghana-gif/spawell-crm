# Copy to .env.local and fill from your Supabase project settings.
# Project Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Server-only. Never expose to the browser, never commit.
# Only needed if you add scheduled jobs or admin scripts.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# --- Integrations, added when you wire them up (all optional to run the app) ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GA4_PROPERTY_ID=
PAYMENT_PROVIDER_PUBLIC_KEY=
PAYMENT_PROVIDER_SECRET_KEY=
CRON_SECRET=
APP_TIMEZONE=Africa/Accra

# ------------------------------------------------- Google Ads conversions
# Until these are set the integration reports "Configuration required".
# Attribution is still captured and conversions still queue; nothing is sent.

# Google Ads account the conversion belongs to. Dashes optional.
GOOGLE_ADS_CUSTOMER_ID=
# Only if a manager (MCC) account manages the above.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# The conversion action id created in Google Ads, e.g. "Confirmed Massage
# Booking" with goal "Qualified lead" / "Converted lead".
GOOGLE_ADS_CONVERSION_ACTION=
# Service account with access to the Data Manager API and the Ads account.
GOOGLE_ADS_SA_CLIENT_EMAIL=
GOOGLE_ADS_SA_PRIVATE_KEY=
# Master switch. Leave false until a validation run has passed.
GOOGLE_ADS_SYNC_ENABLED=false
# Shared secret for external POST /api/conversions/sync calls.
# Vercel's scheduled GET uses CRON_SECRET (listed above), a separate secret.
CONVERSION_SYNC_SECRET=

# ----------------------------------------------------- website attribution
# Origins allowed to POST to /api/attribution.
ATTRIBUTION_ALLOWED_ORIGINS=https://spawellghana.com,https://www.spawellghana.com
