# GA4 — add these in Vercel (Settings → Environment Variables), not in git.
# The app runs fine without them; the Marketing page just shows no sessions.

# --- Reading website traffic (Data API) ---
# Already known: your property is 314693631 ("spawellghana.com - GA4").
GA4_PROPERTY_ID=314693631
# Google Cloud service account with Viewer on the GA4 property.
GA4_SA_CLIENT_EMAIL=
# The private_key from its JSON key file, in quotes, newlines left as \n.
GA4_SA_PRIVATE_KEY=

# --- Sending bookings back (Measurement Protocol) ---
# GA4 Admin → Data Streams → your web stream → Measurement ID (G-XXXXXXXXXX)
GA4_MEASUREMENT_ID=
# Same screen → Measurement Protocol API secrets → Create
GA4_API_SECRET=

# --- SIMPLER ALTERNATIVE: Windsor.ai ---
# One key instead of a Google Cloud service account. GA4 and Google Ads are
# already authorised there. Set these INSTEAD of the three GA4_SA_* values
# above; if both are set, the direct Google connection wins.
# Key from onboard.windsor.ai -> Data preview.
WINDSOR_API_KEY=
WINDSOR_GA4_ACCOUNT=314693631
WINDSOR_ADS_ACCOUNT=627-977-5396
